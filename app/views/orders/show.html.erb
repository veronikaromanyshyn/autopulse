<% content_for :title, "Замовлення #{@order.number}" %>
<div class="order-done panel">
  <h1>Замовлення <%= @order.number %></h1>
  <p>Статус: <%= status_badge(@order) %> · від <%= l(@order.created_at) %></p>
  <div class="grid-2">
    <div>
      <h4>Отримувач</h4>
      <p><%= @order.full_name %><br><%= @order.phone %><br><%= @order.email %></p>
    </div>
    <div>
      <h4>Доставка та оплата</h4>
      <p><%= @order.delivery_method.name %>: <%= @order.city %>, <%= @order.address %><br>
         <%= @order.payment_name %>
         <% if @order.paid? %><br>✅ Оплачено <%= l(@order.paid_at) %>, картка **** <%= @order.card_last4 %><% end %></p>
    </div>
  </div>
  <table class="table">
    <thead><tr><th>Товар</th><th>Ціна</th><th>К-сть</th><th>Сума</th></tr></thead>
    <% @order.order_items.each do |i| %>
      <tr><td><%= i.product&.name || "Товар видалено" %></td><td><%= uah(i.price) %></td><td><%= i.quantity %></td><td><%= uah(i.total_price) %></td></tr>
    <% end %>
    <tr><td colspan="3">Доставка</td><td><%= @order.delivery_cost.zero? ? "безкоштовно" : uah(@order.delivery_cost) %></td></tr>
    <tr class="total"><td colspan="3"><b>Разом</b></td><td><b><%= uah(@order.total) %></b></td></tr>
  </table>
  <% if @order.payment_method == "card" && !@order.paid? %>
    <%= link_to "Оплатити замовлення", new_order_payment_path(@order), class: "btn" %>
  <% end %>
  <%= link_to "Продовжити покупки", products_path, class: "btn btn-outline" %>
</div>

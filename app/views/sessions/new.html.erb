<% content_for :title, "Вхід" %>
<div class="auth-box">
  <h1>Вхід до кабінету</h1>
  <%= form_with url: login_path, local: true do %>
    <%= label_tag :email, "Email" %><%= email_field_tag :email, params[:email], required: true %>
    <%= label_tag :password, "Пароль" %><%= password_field_tag :password, nil, required: true %>
    <button type="submit" class="btn btn-block">Увійти</button>
  <% end %>
  <p>Немає акаунта? <%= link_to "Зареєструватися", signup_path %></p>
</div>

<div class="admin-head">
  <h1>Товари</h1>
  <%= link_to "+ Додати товар", new_admin_product_path, class: "btn" %>
</div>
<%= form_with url: admin_products_path, method: :get, local: true, class: "search inline" do %>
  <%= search_field_tag :q, params[:q], placeholder: "Пошук за назвою або артикулом" %><button>Знайти</button>
<% end %>
<table class="table admin-table">
  <thead><tr><th></th><th>Назва</th><th>Артикул</th><th>Категорія</th><th>Ціна</th><th>Залишок</th><th></th></tr></thead>
  <% @products.each do |p| %>
    <tr>
      <td><%= product_image(p, "thumb-img") %></td>
      <td><%= p.name %><% if p.featured %> <span class="badge badge-paid">хіт</span><% end %><br><small class="muted"><%= p.brand %></small></td>
      <td><%= p.sku %></td>
      <td><%= p.category.name %></td>
      <td><%= uah(p.price) %></td>
      <td class="<%= 'low' if p.stock < 5 %>"><%= p.stock %></td>
      <td class="actions"><%= link_to "Редагувати", edit_admin_product_path(p) %>
        <%= button_to "Видалити", admin_product_path(p), method: :delete, class: "link-btn danger" %></td>
    </tr>
  <% end %>
</table>
